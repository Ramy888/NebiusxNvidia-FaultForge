# Nebius Token Factory (OpenAI-compatible). Nemotron models are region-scoped.
NEBIUS_API_KEY=
NEBIUS_AI_PROJECT=
# Planning/analysis role (Nemotron Ultra, us-central1) and writing role (Nemotron Nano, eu-north1).
# Defaults are built in; override only if the console shows different values.
PLAN_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
PLAN_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
WRITE_BASE_URL=https://api.tokenfactory.nebius.com/v1
WRITE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Set to 1 to request response_format=json_object (only if the spike shows it works)
TF_JSON_MODE=

# Sandboxes: "local" (offline) or "contree" (Token Factory Sandboxes)
FAULTFORGE_SANDBOX=local

# Tavily web research
TAVILY_API_KEY=

# GitHub token for opening pull requests
GITHUB_TOKEN=
