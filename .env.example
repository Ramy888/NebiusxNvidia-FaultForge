# Nebius Token Factory (OpenAI-compatible). Nemotron models are region-scoped.
NEBIUS_API_KEY=
NEBIUS_AI_PROJECT=
TF_BASE_URL_EU=https://api.tokenfactory.nebius.com/v1
TF_BASE_URL_US=https://api.tokenfactory.us-central1.nebius.com/v1
MODEL_PLAN=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_WRITE=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Sandboxes: "local" (offline) or "contree" (Token Factory Sandboxes)
FAULTFORGE_SANDBOX=local

# Tavily web research
TAVILY_API_KEY=

# GitHub token for opening pull requests
GITHUB_TOKEN=
